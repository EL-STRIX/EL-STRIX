# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
env/
ENV/
.venv/

# IDE & Editor files
.vscode/
.idea/
*.swp
*.swo

# Testing & Coverage
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Generated output (preserve directory structure via .gitkeep)
# Cache and temp are always ignored
generated/cache/*
generated/temp/*
generated/logs/*

# JSON data and stats are committed so they persist across CI runs
# (only ignored locally if you want a clean slate)

# SVG intermediates are ignored (final output goes to assets/svg/)
generated/svg/*

!generated/**/.gitkeep

# Environment variables
.env

# Logs
*.log
